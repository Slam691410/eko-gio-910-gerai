# GERAI 910 - PRODUCTION SAAS CONFIGURATION ENVIRONMENT TEMPLATE 🚀
# Salin berkas ini menjadi '.env' dan isi dengan kunci API produksi Anda untuk mengaktifkan integrasi riil dunia!

PORT=3000

# =================================================================
# 0. KEAMANAN API
# Token wajib untuk endpoint admin: POST /api/db, /api/blockchain/mint, /api/dev/*
# Header yang dikirim: Authorization: Bearer <ADMIN_API_TOKEN>
# Jika dikosongkan, endpoint tersebut TERBUKA (mode development) — WAJIB diisi untuk produksi!
ADMIN_API_TOKEN=

# Origin yang diizinkan untuk CORS (jika kosong, CORS nonaktif = same-origin saja)
CORS_ORIGIN=

# =================================================================
# 1. KUNCI API KECERDASAN BUATAN (AI FINANCE ADVISOR)
# Masukkan salah satu kunci di bawah ini untuk menghubungkan GeraiAI ke LLM komersial riil.
# Jika dibiarkan kosong, server akan menggunakan mesin analisis NLP operasional-aktif lokal kami secara otomatis.

# Integrasi OpenAI (GPT-4o / GPT-4-mini)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Integrasi Anthropic Claude (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Integrasi Ollama (Local AI Node - Llama3 / Mistral)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3


# =================================================================
# 2. INTEGRASI JARINGAN BLOCKCHAIN WEB3 (MAINNET / TESTNET)
# Hubungkan platform ke RPC node riil untuk menandatangani transaksi on-chain.

# Provider RPC Node (Infura / Alchemy / QuickNode)
WEB3_PROVIDER_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your_api_key

# Alamat Smart Contract Treasury Terbuka (Solidity Contract)
TREASURY_SMART_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Private Key Dompet Master Platform (Untuk penarikan otomatis / payout komisi)
WEB3_PLATFORM_MASTER_PRIVATE_KEY=your_private_key_here


# =================================================================
# 3. INTEGRASI FEED HARGA RIIL PASAR KEUANGAN (MARKET DATA API)
# Masukkan kunci untuk menarik harga emas, perak, dan saham secara riil & otomatis per detik.

# Spot Logam Mulia API (Emas & Perak - via goldapi.io / metals-api.com)
GOLD_PRICE_API_KEY=your_gold_api_key_here

# Pasar Saham BEI / IHSG & Crypto API (via AlphaVantage / CoinGecko Premium)
ALPHA_VANTAGE_API_KEY=your_alphavantage_key_here
COINGECKO_PREMIUM_API_KEY=your_coingecko_premium_key_here


# =================================================================
# 4. GERBANG PEMBAYARAN RIIL (PAYMENT GATEWAY - MIDTRANS INDONESIA)
# Hubungkan ke Midtrans untuk melayani penerbitan invoice QRIS rill, Bank VA, dan kartu kredit.

MIDTRANS_ENVIRONMENT=sandbox # sandox / production
MIDTRANS_SERVER_KEY=your_midtrans_server_key_here
MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here


# =================================================================
# 5. ATURAN BAGI HASIL AFILIASI MASTER (SAAS OWNER CONTROLS)
MASTER_AFFILIATE_CODE=MASTER_GERAI910
MASTER_AFFILIATE_PERCENT=30 # 30% untuk platform master, 70% untuk pengguna (sub-affiliate)
